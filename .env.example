# Environment Variables Configuration Template
# Copy this file to .env and populate credentials if using Google Cloud Platform

# Execution Mode: LOCAL or GCP
PIPELINE_EXECUTION_MODE=LOCAL

# Optional Google Cloud Platform Settings
# (Leave blank for local DuckDB execution)
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-gcs-bucket-name
GCS_INPUT_PREFIX=raw_transactions/
BIGQUERY_DATASET=retail_analytics
BIGQUERY_TABLE=retail_transactions
BIGQUERY_REJECTED_TABLE=rejected_transactions
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

