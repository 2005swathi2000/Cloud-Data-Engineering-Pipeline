# Environment Variables Configuration Template
# Copy this file to .env and populate credentials if using Google Cloud BigQuery Sandbox / GCP
# Authentication: Uses Application Default Credentials (ADC) only
# Run: gcloud auth application-default login

# Target Execution Mode: duckdb (default local) or bigquery
PIPELINE_TARGET=duckdb

# Google Cloud Platform Settings (Free Tier / BigQuery Sandbox Compatible)
# Primary variable: GCP_PROJECT (fallback: GCP_PROJECT_ID)
GCP_PROJECT=your-gcp-project-id
# GCP_PROJECT_ID=your-gcp-project-id

# BigQuery Dataset and Table Configurations
BQ_DATASET=retail_analytics
BQ_TABLE=retail_transactions
BQ_REJECTED_TABLE=rejected_transactions

# BigQuery Dataset Location (e.g. US, EU, asia-south1)
BQ_LOCATION=US

# Optional Google Cloud Storage bucket
GCS_BUCKET=your-gcs-bucket-name
GCS_INPUT_PREFIX=raw_transactions/
